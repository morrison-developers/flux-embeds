{
  "name": "flux-embeds",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4200",
    "prebuild": "npm run prisma:generate",
    "build": "next build",
    "start": "next start -p 4200",
    "lint": "eslint",
    "gen:feature": "node scripts/gen-feature.mjs",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-${POSTGRES_URL:-$POSTGRES_PRISMA_URL}} DIRECT_URL=${DIRECT_URL:-${POSTGRES_URL_NON_POOLING:-${POSTGRES_URL:-$POSTGRES_PRISMA_URL}}} prisma generate",
    "prisma:migrate": "DATABASE_URL=${DATABASE_URL:-${POSTGRES_URL:-$POSTGRES_PRISMA_URL}} DIRECT_URL=${DIRECT_URL:-${POSTGRES_URL_NON_POOLING:-${POSTGRES_URL:-$POSTGRES_PRISMA_URL}}} prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "cloudinary": "^2.9.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-photo-album": "^3.5.1",
    "yet-another-react-lightbox": "^3.29.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.0.0",
    "prisma": "^6.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.0.6"
  },
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8"
}
